# Supabase (Project Settings → API). Safe for the browser:
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Cloudflare Turnstile (Phase 2+) — site key only in the frontend:
VITE_TURNSTILE_SITE_KEY=

# Never put SUPABASE_SERVICE_ROLE_KEY in frontend or Cloudflare Pages env for the site build.
